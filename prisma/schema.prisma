generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Admin Users ────────────────────────────────────────

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @default("Admin") @map("full_name")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// ─── Hero Carousel Slides ───────────────────────────────

model Slide {
  id         Int      @id @default(autoincrement())
  title      String   @db.VarChar(200)
  subtitle   String?  @db.VarChar(300)
  image      String   @db.VarChar(500)
  buttonText String?  @map("button_text") @db.VarChar(100)
  buttonUrl  String?  @map("button_url") @db.VarChar(500)
  sortOrder  Int      @default(0) @map("sort_order")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("slides")
}

// ─── News Articles ──────────────────────────────────────

model News {
  id          Int       @id @default(autoincrement())
  title       String    @db.VarChar(300)
  slug        String    @unique @db.VarChar(300)
  excerpt     String?   @db.VarChar(500)
  content     String    @db.Text
  image       String?   @db.VarChar(500)
  isPublished Boolean   @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at")
  views       Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([slug])
  @@index([isPublished])
  @@map("news")
}

// ─── Events ─────────────────────────────────────────────

model Event {
  id              Int       @id @default(autoincrement())
  title           String    @db.VarChar(300)
  slug            String    @unique @db.VarChar(300)
  description     String    @db.Text
  image           String?   @db.VarChar(500)
  location        String?   @db.VarChar(300)
  startDate       DateTime  @map("start_date")
  endDate         DateTime? @map("end_date")
  registrationUrl String?   @map("registration_url") @db.VarChar(500)
  isPublished     Boolean   @default(false) @map("is_published")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([slug])
  @@index([isPublished])
  @@map("events")
}

// ─── Statistics Bar ─────────────────────────────────────

model Statistic {
  id        Int     @id @default(autoincrement())
  value     String  @db.VarChar(50)
  label     String  @db.VarChar(200)
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  @@map("statistics")
}

// ─── Partner Companies ──────────────────────────────────

model Partner {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(200)
  logo        String   @db.VarChar(500)
  website     String?  @db.VarChar(500)
  description String?  @db.Text
  category    String?  @db.VarChar(100)
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("partners")
}

// ─── Static Pages ───────────────────────────────────────

model Page {
  id              Int      @id @default(autoincrement())
  title           String   @db.VarChar(300)
  slug            String   @unique @db.VarChar(300)
  content         String   @db.Text
  metaDescription String?  @map("meta_description") @db.VarChar(500)
  isPublished     Boolean  @default(true) @map("is_published")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([slug])
  @@map("pages")
}

// ─── Site Settings (key-value) ──────────────────────────

model SiteSetting {
  id          Int     @id @default(autoincrement())
  key         String  @unique @db.VarChar(100)
  value       String  @db.Text
  description String? @db.VarChar(300)

  @@map("site_settings")
}

// ─── Navigation Menu Items ──────────────────────────────

model MenuItem {
  id           Int      @id @default(autoincrement())
  title        String   @db.VarChar(100)
  url          String   @db.VarChar(500)
  parentId     Int?     @map("parent_id")
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  menuLocation String   @default("main") @map("menu_location") @db.VarChar(50)

  @@map("menu_items")
}

// ─── Franchise Directory ────────────────────────────────

model Franchise {
  id                Int      @id @default(autoincrement())
  name              String   @db.VarChar(300)
  slug              String   @unique @db.VarChar(300)
  logo              String?  @db.VarChar(500)
  category          String   @db.VarChar(100)
  description       String?  @db.Text
  headquarters      String?  @db.VarChar(200)
  startupCost       String?  @map("startup_cost") @db.VarChar(100)
  totalInvestment   String?  @map("total_investment") @db.VarChar(100)
  franchisingSince  String?  @map("franchising_since") @db.VarChar(20)
  website           String?  @db.VarChar(500)
  contactEmail      String?  @map("contact_email") @db.VarChar(100)
  contactPhone      String?  @map("contact_phone") @db.VarChar(30)
  veteransDiscount  Boolean  @default(false) @map("veterans_discount")
  discountDetails   String?  @map("discount_details") @db.VarChar(300)
  isFeatured        Boolean  @default(false) @map("is_featured")
  isActive          Boolean  @default(true) @map("is_active")
  sortOrder         Int      @default(0) @map("sort_order")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([slug])
  @@index([category])
  @@index([isActive])
  @@index([isFeatured])
  @@map("franchises")
}

// ─── Franchise Categories ───────────────────────────────

model FranchiseCategory {
  id       Int     @id @default(autoincrement())
  name     String  @unique @db.VarChar(100)
  slug     String  @unique @db.VarChar(100)
  icon     String? @db.VarChar(50)
  sortOrder Int    @default(0) @map("sort_order")

  @@map("franchise_categories")
}

// ─── Website Lead Submissions (→ CRM) ───────────────────

model WebsiteLead {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  email     String   @db.VarChar(100)
  phone     String?  @db.VarChar(30)
  company   String?  @db.VarChar(200)
  subject   String?  @db.VarChar(200)
  message   String   @db.Text
  formType  String   @default("contact") @map("form_type") @db.VarChar(50)
  isRead    Boolean  @default(false) @map("is_read")
  sentToCrm Boolean  @default(false) @map("sent_to_crm")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("website_leads")
}
